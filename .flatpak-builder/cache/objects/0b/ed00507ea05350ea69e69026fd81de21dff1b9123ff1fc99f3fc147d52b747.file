[Application]
name=io.github.JordanGrant3D.stack
runtime=org.freedesktop.Platform/x86_64/23.08
sdk=org.freedesktop.Sdk/x86_64/23.08
command=stack

[Context]
shared=ipc;
sockets=x11;fallback-x11;
devices=all;
filesystems=host:ro;

[Extension io.github.JordanGrant3D.stack.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=io.github.JordanGrant3D.stack.Debug;